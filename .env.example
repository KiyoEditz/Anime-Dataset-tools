# =============================================================
# PICK ONE PROVIDER BELOW
# Uncomment the block you want to use (remove the leading #),
# leave the rest commented out. Replace the xxx values with
# your own real key/url.
# =============================================================


# ─────────────────────────────────────────────────────────────
# OPTION 1 ★ BEST — Claude Sonnet via your own LiteLLM (Anthropic)
# Use this once you've added Anthropic to your Colab LiteLLM
# config.yaml (see the README's "Setting up LiteLLM + Claude" section).
# Best quality for literary extraction & consistent JSON.
# Sign up + API key: console.anthropic.com
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://your-tunnel-name.trycloudflare.com/v1
# LLM_API_KEY=sk-local
# LLM_MODEL=claude-sonnet
# PERSONA_CHUNK_CHARS=30000
# DIALOGUE_CHUNK_CHARS=20000
# MAX_PROFILE_CHARS=12000


# ─────────────────────────────────────────────────────────────
# OPTION 2 ★★ — Claude Sonnet via OpenRouter (permanent endpoint)
# Doesn't go down when your Colab session ends.
# Requires a one-time $10 top-up for Claude access.
# Sign up + API key: openrouter.ai → Keys
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace-with-your-key
LLM_MODEL=anthropic/claude-sonnet-4-6
PERSONA_CHUNK_CHARS=30000
DIALOGUE_CHUNK_CHARS=20000
MAX_PROFILE_CHARS=12000
LLM_MIN_SECONDS_BETWEEN_CALLS=0


# ─────────────────────────────────────────────────────────────
# OPTION 3 — Groq (Llama-3.3-70B) — free, OpenAI-compatible
# Best fallback if you're on a tight budget. Good quality for
# structured instruction-following.
# Sign up + API key: console.groq.com → API Keys (no card needed)
#
# Groq's free tier enforces TWO separate limits: tokens-per-day (TPD,
# e.g. 100,000/day) AND tokens-per-minute (TPM, e.g. 12,000/min) --
# check console.groq.com/settings/limits for your account's exact
# numbers, they can vary by model/tier. LLM_TPM_LIMIT below is set a
# bit under the real 12,000 cap as a safety margin, since token counts
# are estimated before the real usage is known.
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_replace-with-your-key
# LLM_MODEL=llama-3.3-70b-versatile
# PERSONA_CHUNK_CHARS=4000
# DIALOGUE_CHUNK_CHARS=3000
# MAX_PROFILE_CHARS=6000
# LLM_MIN_SECONDS_BETWEEN_CALLS=1.5
# LLM_TPM_LIMIT=11000
# LLM_MAX_OUTPUT_TOKENS=1500


# ─────────────────────────────────────────────────────────────
# OPTION 4 — Google Gemini 2.5 Flash — free, 1M token context
# NOTE: on the free tier, Google may use your input to train
# their models. Fine if you're not concerned about that.
# Sign up + API key: aistudio.google.com → Get API Key (no card needed)
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza-replace-with-your-key
# LLM_MODEL=gemini-2.5-flash
# PERSONA_CHUNK_CHARS=50000
# DIALOGUE_CHUNK_CHARS=35000
# MAX_PROFILE_CHARS=20000
# LLM_MIN_SECONDS_BETWEEN_CALLS=0.5


# ─────────────────────────────────────────────────────────────
# OPTION 5 — Your own local LiteLLM (Hermes-4-14B abliterated)
# Use this only for testing the pipeline, not for producing the
# final dataset (its JSON output tends to be less consistent).
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://your-tunnel-name.trycloudflare.com/v1
# LLM_API_KEY=sk-local
# LLM_MODEL=hermes-4-14b
# PERSONA_CHUNK_CHARS=4000
# DIALOGUE_CHUNK_CHARS=3000
# MAX_PROFILE_CHARS=6000
# LLM_MIN_SECONDS_BETWEEN_CALLS=0


# ─────────────────────────────────────────────────────────────
# GENERAL SETTINGS (apply to whichever provider you picked above)
# ─────────────────────────────────────────────────────────────
# Rate-limit wait threshold: if a provider's 429 error asks for a wait
# longer than this many seconds, the script stops with a clear message
# instead of sleeping in place (see the README's "If the script stops
# due to a rate limit / error" section). Default: 300 (5 minutes).
# LLM_MAX_AUTO_SLEEP_SECONDS=300

# Tokens-per-minute budget. If your provider enforces a TPM cap (Groq
# does; NVIDIA Build, OpenRouter, and Gemini generally don't on their
# standard free/paid tiers), set this so the script PROACTIVELY paces
# requests to stay under it, instead of firing requests and hitting 429s.
# Default 0 = disabled (no TPM pacing).
# LLM_TPM_LIMIT=0

# Cap on tokens generated per call. Also used to reserve TPM budget
# before the real usage is known. Raise this if you see JSON getting
# truncated (usually shows up as repeated "Failed to get valid JSON"
# warnings on calls with large inputs, like profile compression).
# LLM_MAX_OUTPUT_TOKENS=2048
