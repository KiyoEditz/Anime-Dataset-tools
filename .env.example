# =============================================================
# PILIH SALAH SATU PROVIDER DI BAWAH
# Hapus tanda # pada blok yang ingin dipakai, sisanya biarkan
# ter-comment. Ganti nilai xxx dengan key/url asli kamu.
# =============================================================


# ─────────────────────────────────────────────────────────────
# OPSI 1 ★ TERBAIK — Claude Sonnet via LiteLLM kamu (Anthropic)
# Pakai ini kalau sudah tambahkan Anthropic ke config.yaml
# LiteLLM di Colab (lihat README bagian "Setup LiteLLM + Claude").
# Kualitas terbaik untuk literary extraction & JSON konsisten.
# Daftar + API key: console.anthropic.com
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://nama-tunnel-kamu.trycloudflare.com/v1
# LLM_API_KEY=sk-local
# LLM_MODEL=claude-sonnet
# PERSONA_CHUNK_CHARS=30000
# DIALOGUE_CHUNK_CHARS=20000
# MAX_PROFILE_CHARS=12000


# ─────────────────────────────────────────────────────────────
# OPSI 2 ★★ — Claude Sonnet via OpenRouter (endpoint permanen)
# Tidak ikut mati kalau Colab session berakhir.
# Butuh top-up $10 sekali untuk akses Claude.
# Daftar + API key: openrouter.ai → Keys
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-ganti-dengan-key-kamu
LLM_MODEL=anthropic/claude-sonnet-4-6
PERSONA_CHUNK_CHARS=30000
DIALOGUE_CHUNK_CHARS=20000
MAX_PROFILE_CHARS=12000
LLM_MIN_SECONDS_BETWEEN_CALLS=0


# ─────────────────────────────────────────────────────────────
# OPSI 3 — Groq (Llama-3.3-70B) — gratis, OpenAI-compatible
# Fallback terbaik kalau tidak punya budget. Kualitas bagus
# untuk instruction-following terstruktur.
# Daftar + API key: console.groq.com → API Keys (tanpa CC)
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_ganti-dengan-key-kamu
# LLM_MODEL=llama-3.3-70b-versatile
# PERSONA_CHUNK_CHARS=6000
# DIALOGUE_CHUNK_CHARS=4000
# MAX_PROFILE_CHARS=8000
# LLM_MIN_SECONDS_BETWEEN_CALLS=1.5


# ─────────────────────────────────────────────────────────────
# OPSI 4 — Google Gemini 2.5 Flash — gratis, context 1M token
# PERHATIAN: free tier = Google boleh pakai input kamu untuk
# training model mereka. Cocok kalau tidak keberatan soal itu.
# Daftar + API key: aistudio.google.com → Get API Key (tanpa CC)
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza-ganti-dengan-key-kamu
# LLM_MODEL=gemini-2.5-flash
# PERSONA_CHUNK_CHARS=50000
# DIALOGUE_CHUNK_CHARS=35000
# MAX_PROFILE_CHARS=20000
# LLM_MIN_SECONDS_BETWEEN_CALLS=0.5


# ─────────────────────────────────────────────────────────────
# OPSI 5 — LiteLLM lokal kamu (Hermes-4-14B abliterated)
# Pakai ini hanya untuk testing pipeline, bukan untuk produksi
# dataset final (kualitas JSON-nya kurang konsisten).
# ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://nama-tunnel-kamu.trycloudflare.com/v1
# LLM_API_KEY=sk-local
# LLM_MODEL=hermes-4-14b
# PERSONA_CHUNK_CHARS=4000
# DIALOGUE_CHUNK_CHARS=3000
# MAX_PROFILE_CHARS=6000
# LLM_MIN_SECONDS_BETWEEN_CALLS=0
